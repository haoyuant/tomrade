{
  "name": "@tomrade/review",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The store's review worker and admin tool: builds each submitted commit, tests it in a sandbox, reads it with the static analyzer and Claude, applies the listing rules, signs and uploads what is listed",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "tomrade-review": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker": "node dist/cli.js worker"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tomrade/community": "workspace:*",
    "@tomrade/plugin-cli": "workspace:*",
    "@tomrade/plugin-kit": "workspace:*",
    "@tomrade/plugin-sdk": "workspace:*",
    "tar": "^7.5.22",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0"
  }
}
