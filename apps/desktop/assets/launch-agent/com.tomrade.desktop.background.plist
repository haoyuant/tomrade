<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Tomrade's background part at login (src/login-item.ts registers it through
  SMAppService). Restarted after a crash, never after the person quits.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tomrade.desktop.background</string>
  <key>BundleProgram</key>
  <string>Contents/MacOS/Tomrade</string>
  <key>ProgramArguments</key>
  <array>
    <string>Contents/MacOS/Tomrade</string>
    <string>--background</string>
  </array>
  <key>AssociatedBundleIdentifiers</key>
  <array>
    <string>com.tomrade.desktop</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>LimitLoadToSessionType</key>
  <string>Aqua</string>
  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
