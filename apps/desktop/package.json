{
  "name": "@tomrade/desktop",
  "private": true,
  "license": "BUSL-1.1",
  "version": "0.1.0",
  "type": "module",
  "description": "Electron shell: boots the cordis context from tomrade.yml, supplies the IPC transport, opens the window",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ui": "electron scripts/ui-regression.mjs",
    "test:plugins": "electron scripts/plugins-check.mjs",
    "test:media": "electron scripts/media-check.mjs",
    "dev": "pnpm -w run build:backend && node scripts/dev.mjs",
    "dev:ui": "pnpm --filter @tomradex/ui dev",
    "start": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dump-config": "electron . --dump-config",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test:files": "electron scripts/files-check.mjs",
    "test:notes": "electron scripts/notes-check.mjs",
    "test:agent-panel": "electron scripts/agent-panel-check.mjs",
    "test:restore": "electron scripts/restore-check.mjs",
    "test:updates": "electron scripts/updates-check.mjs",
    "test:extensions": "electron scripts/extensions-check.mjs",
    "test:plugins-ui": "electron scripts/plugins-ui-check.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@tomradex/agent": "workspace:*",
    "@tomradex/agent-backlog": "workspace:*",
    "@tomradex/archify": "workspace:*",
    "@tomradex/boards": "workspace:*",
    "@tomradex/code-link": "workspace:*",
    "@tomradex/community": "workspace:*",
    "@tomradex/contributions": "workspace:*",
    "@tomradex/db": "workspace:*",
    "@tomradex/deps-graph": "workspace:*",
    "@tomradex/desktop-surface": "workspace:*",
    "@tomradex/engine-claude-code": "workspace:*",
    "@tomradex/engine-codex": "workspace:*",
    "@tomradex/engine-loop": "workspace:*",
    "@tomradex/engine-scripted": "workspace:*",
    "@tomradex/extensions": "workspace:*",
    "@tomradex/fields": "workspace:*",
    "@tomradex/files": "workspace:*",
    "@tomradex/files-github": "workspace:*",
    "@tomradex/notes": "workspace:*",
    "@tomradex/hub": "workspace:*",
    "@tomradex/hub-cloud": "workspace:*",
    "@tomradex/ipc": "workspace:*",
    "@tomradex/items": "workspace:*",
    "@tomradex/llm": "workspace:*",
    "@tomradex/mcp": "workspace:*",
    "@tomradex/mcp-client": "workspace:*",
    "@tomradex/oplog": "workspace:*",
    "@tomradex/pet": "workspace:*",
    "@tomradex/plugin-cli": "workspace:*",
    "@tomradex/plugin-kit": "workspace:*",
    "@tomradex/plugin-sdk": "workspace:*",
    "@tomradex/plugin-studio": "workspace:*",
    "@tomradex/plugins": "workspace:*",
    "@tomradex/projects": "workspace:*",
    "@tomradex/repos": "workspace:*",
    "@tomradex/settings": "workspace:*",
    "@tomradex/storage": "workspace:*",
    "@tomradex/storage-git": "workspace:*",
    "@tomradex/storage-github": "workspace:*",
    "@tomradex/tools": "workspace:*",
    "@tomradex/write": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "electron-updater": "6.8.10",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.0",
    "wait-on": "^8.0.1"
  }
}
