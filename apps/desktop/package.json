{
  "name": "@tomrade/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Electron shell: boots the cordis context from tomrade.yml, supplies the IPC transport, opens the window",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:ui": "electron scripts/ui-regression.mjs",
    "test:plugins": "electron scripts/plugins-check.mjs",
    "dev": "pnpm -w run build:backend && concurrently -k \"pnpm -F @tomrade/ui exec vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\" || true",
    "dev:ui": "pnpm --filter @tomrade/ui dev",
    "start": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dump-config": "electron . --dump-config",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@tomrade/agent": "workspace:*",
    "@tomrade/agent-backlog": "workspace:*",
    "@tomrade/boards": "workspace:*",
    "@tomrade/contributions": "workspace:*",
    "@tomrade/db": "workspace:*",
    "@tomrade/deps-graph": "workspace:*",
    "@tomrade/engine-claude-code": "workspace:*",
    "@tomrade/engine-codex": "workspace:*",
    "@tomrade/engine-loop": "workspace:*",
    "@tomrade/engine-scripted": "workspace:*",
    "@tomrade/fields": "workspace:*",
    "@tomrade/ipc": "workspace:*",
    "@tomrade/items": "workspace:*",
    "@tomrade/llm": "workspace:*",
    "@tomrade/mcp": "workspace:*",
    "@tomrade/oplog": "workspace:*",
    "@tomrade/plugins": "workspace:*",
    "@tomrade/projects": "workspace:*",
    "@tomrade/settings": "workspace:*",
    "@tomrade/storage": "workspace:*",
    "@tomrade/storage-git": "workspace:*",
    "@tomrade/storage-github": "workspace:*",
    "@tomrade/tools": "workspace:*",
    "@tomrade/write": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^26.2.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.4.0",
    "typescript": "^6.0.0",
    "wait-on": "^8.0.1"
  }
}
