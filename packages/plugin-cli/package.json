{
  "name": "@tomrade/plugin-cli",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "tomrade-plugin: scaffold, build, inspect, test, check and pack a plugin; the same steps Plugin Studio runs for the agent",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomrade/contributions": "workspace:*",
    "@tomrade/extensions": "workspace:*",
    "@tomrade/plugin-kit": "workspace:*",
    "@tomrade/plugin-sdk": "workspace:*",
    "@tomrade/settings": "workspace:*",
    "@tomrade/testkit": "workspace:*",
    "@tomrade/tools": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "esbuild": "^0.25.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "@types/node": "^26.2.0"
  },
  "bin": {
    "tomrade-plugin": "dist/cli.js"
  }
}
