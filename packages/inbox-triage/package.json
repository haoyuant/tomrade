    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomradex/agent-backlog": "workspace:*",
    "@tomradex/domain": "workspace:*",
    "@tomradex/inbox": "workspace:*",
    "@tomradex/items": "workspace:*",
    "@tomradex/llm": "workspace:*",
    "@tomradex/settings": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0"
  }
}
