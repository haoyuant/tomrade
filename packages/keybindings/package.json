{
  "name": "@tomradex/keybindings",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "description": "The person's keyboard shortcuts: which keys run which command, carried with their settings",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./chord": {
      "types": "./dist/chord.d.ts",
      "default": "./dist/chord.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomradex/domain": "workspace:*",
    "@tomradex/settings": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
