{
  "name": "@tomradex/acp-registry",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "description": "Agents from the ACP registry: the person adds one in Settings and Tomrade runs it over ACP through npx, set up like any plugin agent",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomradex/agent": "workspace:*",
    "@tomradex/contracts": "workspace:*",
    "@tomradex/engine-acp": "workspace:*",
    "@tomradex/ipc": "workspace:*",
    "@tomradex/plugin-sdk": "workspace:*",
    "@tomradex/settings": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0"
  }
}
