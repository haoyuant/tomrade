{
  "name": "@tomrade/engine-codex",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "OpenAI Codex app-server conductor with one reusable local runtime per hot thread, resumable sessions, and explicit CLI fallback",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomrade/agent": "workspace:*",
    "@tomrade/engine-claude-code": "workspace:*",
    "@tomrade/mcp": "workspace:*",
    "@tomrade/settings": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@tomrade/testkit": "workspace:*",
    "@tomrade/tools": "workspace:*",
    "typescript": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
