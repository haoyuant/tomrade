{
  "name": "@tomradex/repos",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "description": "ctx.repos — the code repositories a project's workstreams stand for, where they are checked out here, and the worktrees agents run in",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomradex/boards": "workspace:*",
    "@tomradex/db": "workspace:*",
    "@tomradex/domain": "workspace:*",
    "@tomradex/git": "workspace:*",
    "@tomradex/hub": "workspace:*",
    "@tomradex/ipc": "workspace:*",
    "@tomradex/storage": "workspace:*",
    "@tomradex/tools": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0"
  }
}
