{
  "id": "local/pomodoro",
  "version": "0.1.0",
  "title": "Pomodoro",
  "description": "A status bar Pomodoro timer with a backgroundless desktop widget and adjustable focus and break lengths.",
  "license": "MIT",
  "author": {
    "name": "local"
  },
  "engines": {
    "sdk": "^0.2.3"
  },
  "main": "dist/index.js",
  "permissions": {
    "network": [],
    "fs": "none",
    "exec": false
  },
  "authoredBy": "agent",
  "inject": [
    "settings",
    "contributions",
    "tools"
  ],
  "optional": [
    "surfaces"
  ],
  "contributes": {
    "tools": [
      "pomodoro_control",
      "pomodoro_status"
    ],
    "commands": [
      "pomodoro.desktop",
      "pomodoro.reset",
      "pomodoro.settings",
      "pomodoro.skip",
      "pomodoro.toggle"
    ],
    "statusItems": [
      "pomodoro.status"
    ],
    "settings": [
      "pomodoro"
    ]
  }
}
