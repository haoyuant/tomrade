{
  "name": "@tomrade/plugin-host",
  "private": true,
  "license": "BUSL-1.1",
  "version": "0.0.0",
  "type": "module",
  "description": "The Tomrade a plugin is tested against: a throwaway project with sample issues, the plugin loaded into it, its contributions run",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomrade/contributions": "workspace:*",
    "@tomrade/settings": "workspace:*",
    "@tomrade/testkit": "workspace:*",
    "@tomrade/tools": "workspace:*",
    "cordis": "4.0.0-rc.8"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "@types/node": "^26.2.0"
  }
}
