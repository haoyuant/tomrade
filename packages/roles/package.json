{
  "name": "@tomradex/roles",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "description": "Roles: named, reusable ways of working a ticket (which agents in which order, how far they may go, what more they are told), kept with the project",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./permission": {
      "types": "./dist/permission.d.ts",
      "default": "./dist/permission.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomradex/agent": "workspace:*",
    "@tomradex/contracts": "workspace:*",
    "@tomradex/db": "workspace:*",
    "@tomradex/domain": "workspace:*",
    "@tomradex/ipc": "workspace:*",
    "@tomradex/storage": "workspace:*",
    "cordis": "4.0.0-rc.8"
  },
  "devDependencies": {
    "@tomradex/settings": "workspace:*",
    "@tomradex/testkit": "workspace:*",
    "@tomradex/tools": "workspace:*",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0"
  }
}
