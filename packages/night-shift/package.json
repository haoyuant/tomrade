{
  "name": "@tomradex/night-shift",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "description": "Auto run: the agent plans a batch of tickets on the dependency graph, then works through it in terminal panes or background sessions, within limits the person set",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomradex/agent": "workspace:*",
    "@tomradex/alerts": "workspace:*",
    "@tomradex/code-link": "workspace:*",
    "@tomradex/contracts": "workspace:*",
    "@tomradex/contributions": "workspace:*",
    "@tomradex/db": "workspace:*",
    "@tomradex/dispatch": "workspace:*",
    "@tomradex/domain": "workspace:*",
    "@tomradex/files": "workspace:*",
    "@tomradex/ipc": "workspace:*",
    "@tomradex/items": "workspace:*",
    "@tomradex/llm": "workspace:*",
    "@tomradex/settings": "workspace:*",
    "@tomradex/tools": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tomradex/github": "workspace:*",
    "@tomradex/herdr": "workspace:*",
    "@tomradex/mcp": "workspace:*",
    "@tomradex/repos": "workspace:*",
    "@tomradex/storage": "workspace:*",
    "@tomradex/testkit": "workspace:*",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0"
  }
}
