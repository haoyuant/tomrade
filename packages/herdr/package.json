{
  "name": "@tomradex/herdr",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "description": "ctx.herdr \u2014 herdr (the terminal workspace manager for coding agents) on this machine: its socket, whether it runs, and the panes it holds. Optional; nothing changes without it.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench:latency": "tsc -b && node scripts/bench-latency.mjs"
  },
  "dependencies": {
    "@tomradex/contracts": "workspace:*",
    "@tomradex/domain": "workspace:*",
    "@tomradex/engine-kit": "workspace:*",
    "@tomradex/ipc": "workspace:*",
    "@tomradex/pty-host": "workspace:*",
    "cordis": "4.0.0-rc.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0"
  }
}
