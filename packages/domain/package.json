{
  "name": "@tomradex/domain",
  "private": true,
  "tomrade": {
    "publish": "sdk"
  },
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "description": "Domain types, zod schemas and typed errors. No I/O, no context.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./model-errors": {
      "types": "./dist/model-errors.d.ts",
      "default": "./dist/model-errors.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
