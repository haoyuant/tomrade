  "version": "0.0.0",
  "type": "module",
  "description": "Claude Agent SDK conductor with one reusable local runtime per hot thread, MCP tools, resumable sessions, and explicit CLI fallback",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@tomradex/agent": "workspace:*",
    "@tomradex/llm": "workspace:*",
    "@tomradex/mcp": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0"
  }
}
