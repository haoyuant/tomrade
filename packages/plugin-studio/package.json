{
  "name": "@tomradex/plugin-studio",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "description": "Plugin Studio: tools and a playbook for an agent to write, test and hand over a plugin, which loads only at a build a person confirmed",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomradex/agent": "workspace:*",
    "@tomradex/contracts": "workspace:*",
    "@tomradex/db": "workspace:*",
    "@tomradex/ipc": "workspace:*",
    "@tomradex/plugin-cli": "workspace:*",
    "@tomradex/plugin-kit": "workspace:*",
    "@tomradex/plugin-sdk": "workspace:*",
    "@tomradex/plugins": "workspace:*",
    "@tomradex/tools": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "@types/node": "^26.2.0"
  },
  "files": [
    "dist",
    "playbooks",
    "reference"
  ]
}
