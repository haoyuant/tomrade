{
  "name": "@tomradex/code-link",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "description": "ctx.codeLink — a ticket's branches, worktrees, pull requests and coding sessions. Derives status from git, shows the code on the ticket, and starts a local coding agent on it. First-party, optional.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prompt": {
      "types": "./dist/prompt.d.ts",
      "default": "./dist/prompt.js"
    },
    "./segments": {
      "types": "./dist/segments.d.ts",
      "default": "./dist/segments.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomradex/agent": "workspace:*",
    "@tomradex/boards": "workspace:*",
    "@tomradex/contracts": "workspace:*",
    "@tomradex/contributions": "workspace:*",
    "@tomradex/db": "workspace:*",
    "@tomradex/domain": "workspace:*",
    "@tomradex/engine-kit": "workspace:*",
    "@tomradex/git": "workspace:*",
    "@tomradex/github": "workspace:*",
    "@tomradex/herdr": "workspace:*",
    "@tomradex/hub": "workspace:*",
    "@tomradex/ipc": "workspace:*",
    "@tomradex/items": "workspace:*",
    "@tomradex/llm": "workspace:*",
    "@tomradex/mcp": "workspace:*",
    "@tomradex/plugin-sdk": "workspace:*",
    "@tomradex/repos": "workspace:*",
    "@tomradex/roles": "workspace:*",
    "@tomradex/settings": "workspace:*",
    "@tomradex/storage": "workspace:*",
    "@tomradex/tools": "workspace:*",
    "@tomradex/write": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "smol-toml": "^1.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0"
  }
}
