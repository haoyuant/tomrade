{
  "name": "@tomradex/inbox",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "description": "A project's inbox: feedback and bug reports from its sources wait here until someone triages them into tickets",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomradex/boards": "workspace:*",
    "@tomradex/contributions": "workspace:*",
    "@tomradex/db": "workspace:*",
    "@tomradex/domain": "workspace:*",
    "@tomradex/fields": "workspace:*",
    "@tomradex/ipc": "workspace:*",
    "@tomradex/items": "workspace:*",
    "@tomradex/settings": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0"
  }
}
