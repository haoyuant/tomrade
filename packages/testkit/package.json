{
  "name": "@tomrade/testkit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Boots a fresh in-memory Tomrade context for tests",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomrade/boards": "workspace:*",
    "@tomrade/db": "workspace:*",
    "@tomrade/items": "workspace:*",
    "@tomrade/oplog": "workspace:*",
    "@tomrade/projects": "workspace:*",
    "@tomrade/write": "workspace:*",
    "cordis": "4.0.0-rc.8"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
