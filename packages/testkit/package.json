{
  "name": "@tomradex/testkit",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "description": "Boots a fresh in-memory Tomrade context for tests",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomradex/boards": "workspace:*",
    "@tomradex/db": "workspace:*",
    "@tomradex/extensions": "workspace:*",
    "@tomradex/fields": "workspace:*",
    "@tomradex/hub": "workspace:*",
    "@tomradex/items": "workspace:*",
    "@tomradex/oplog": "workspace:*",
    "@tomradex/plugin-sdk": "workspace:*",
    "@tomradex/projects": "workspace:*",
    "@tomradex/write": "workspace:*",
    "cordis": "4.0.0-rc.8"
  },
  "devDependencies": {
    "@tomradex/domain": "workspace:*",
    "@tomradex/tools": "workspace:*",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0",
    "zod": "^4.4.3"
  }
}
