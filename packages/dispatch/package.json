{
  "name": "@tomradex/dispatch",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.0",
  "type": "module",
  "description": "Work from the account's other machines: whether this machine takes it, within which limits, and a record of every request it took or turned away",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tomradex/code-link": "workspace:*",
    "@tomradex/contracts": "workspace:*",
    "@tomradex/domain": "workspace:*",
    "@tomradex/hub": "workspace:*",
    "@tomradex/hub-cloud": "workspace:*",
    "@tomradex/ipc": "workspace:*",
    "@tomradex/settings": "workspace:*",
    "cordis": "4.0.0-rc.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tomradex/agent": "workspace:*",
    "@tomradex/contributions": "workspace:*",
    "@tomradex/github": "workspace:*",
    "@tomradex/repos": "workspace:*",
    "@tomradex/storage": "workspace:*",
    "@tomradex/testkit": "workspace:*",
    "@tomradex/tools": "workspace:*",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.0"
  }
}
