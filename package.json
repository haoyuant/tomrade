{
  "name": "tomrade-next",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "pnpm dev:desktop",
    "dev:ui": "pnpm --filter @tomrade/ui dev",
    "dev:desktop": "pnpm --filter @tomrade/desktop dev",
    "build": "tsc -b && pnpm --filter @tomrade/ui build",
    "typecheck": "tsc -b && pnpm --filter @tomrade/ui typecheck",
    "test": "vitest run",
    "test:ui": "pnpm --filter @tomrade/desktop test:ui",
    "rebuild:desktop": "pnpm --filter @tomrade/desktop exec electron-rebuild -f -w better-sqlite3",
    "build:backend": "tsc -b",
    "dump-config": "pnpm --filter @tomrade/desktop dump-config"
  },
  "devDependencies": {
    "vitest": "^3.2.7",
    "typescript": "^6.0.0",
    "@types/node": "^26.2.0"
  }
}
