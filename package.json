{
  "name": "tomrade",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "eval:backlog": "pnpm --filter @tomrade/desktop eval:backlog",
    "eval:agents": "vitest run packages/agent/tests/engine-ab.live.test.ts --reporter=verbose",
    "bench:search": "TOMRADE_BENCH=1 vitest run packages/items/tests/search.bench.test.ts --reporter=verbose",
    "dev": "pnpm dev:desktop",
    "dev:ui": "pnpm --filter @tomradex/ui dev",
    "dev:desktop": "pnpm --filter @tomrade/desktop dev",
    "build": "tsc -b && pnpm --filter @tomradex/ui build",
    "typecheck": "tsc -b && pnpm --filter @tomradex/ui typecheck",
    "test": "node scripts/test.mjs",
    "test:related": "node scripts/test.mjs --related",
    "test:ui": "pnpm --filter @tomrade/desktop test:ui",
    "rebuild:desktop": "pnpm --filter @tomrade/desktop exec electron-rebuild -f -w better-sqlite3",
    "build:backend": "tsc -b",
    "i18n:check": "node scripts/i18n-check.mjs",
    "dump-config": "pnpm --filter @tomrade/desktop dump-config"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "vitest": "^3.2.7",
    "typescript": "^6.0.0",
    "@types/node": "^26.2.0"
  }
}
