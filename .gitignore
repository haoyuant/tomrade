node_modules/

# Scratch worktrees another session may be working in — never a nested checkout in a commit.
.claude/worktrees/

dist/
out/
*.tsbuildinfo
.DS_Store
*.log
.env
.env.local
data/*.db
data/*.db-*

# Test scratch directories a run failed to clean up
packages/*/tests/.tmp-*/

# Packaging: npm staging, the renderer copied into the app, and the installers
build/npm/
apps/desktop/ui/
apps/desktop/release/
# The built-in agent's Pi and the lent npm, fetched by apps/desktop/scripts/fetch-*.mjs
apps/desktop/vendor/
# The official starters the app carries, fetched by apps/desktop/scripts/bundle-official-plugins.mjs
apps/desktop/official-plugins/

# UI harness output
apps/desktop/scripts/shots/
artifacts/agent-eval/
artifacts/backlog-eval/
artifacts/search-bench/

# Supabase CLI cache
supabase/.temp/
